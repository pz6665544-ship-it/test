<Page x:Class="SystemHub.Views.FileManager.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SystemHub.Views.FileManager"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="File Explorer" Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="250" MaxWidth="300"/>
            <ColumnDefinition Width="*" MinWidth="500"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" 
                BorderBrush="{DynamicResource MaterialDesignDividers}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0" Padding="10">
                <!-- Quick Access -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Quick Access" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Desktop" Tag="Desktop" Click="QuickAccess_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Documents" Tag="Documents" Click="QuickAccess_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Downloads" Tag="Downloads" Click="QuickAccess_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Pictures" Tag="Pictures" Click="QuickAccess_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Music" Tag="Music" Click="QuickAccess_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Videos" Tag="Videos" Click="QuickAccess_Click"/>
                    </StackPanel>
                </Border>

                <!-- This PC -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="This PC" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Local Disk (C:)" Tag="C:\\" Click="Drive_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Data (D:)" Tag="D:\\" Click="Drive_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Storage (E:)" Tag="E:\\" Click="Drive_Click"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="USB Drive (F:)" Tag="F:\\" Click="Drive_Click"/>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Network" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Network Locations" Tag="Network" Click="Network_Click"/>
                    </StackPanel>
                </Border>

                <!-- Favorites -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Favorites" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavigationItemWithIconStyle}" 
                                Content="Add Current to Favorites" Tag="AddFavorite" Click="AddFavorite_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Address Bar -->
            <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" 
                    BorderBrush="{DynamicResource MaterialDesignDividers}" BorderThickness="1" 
                    CornerRadius="4" Padding="8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Folder" Width="20" Height="20" 
                                            Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource TextBoxStyle}" 
                             Text="C:\\Users\\SystemUser\\Documents" 
                             VerticalAlignment="Center" Width="300"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" 
                            Content="Go" Width="60" Height="30" Click="Go_Click"/>
                </StackPanel>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}" 
                    BorderBrush="{DynamicResource MaterialDesignDividers}" BorderThickness="1" 
                    CornerRadius="4" Padding="8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="New Folder" Margin="0,0,8,0" Click="NewFolder_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="New Folder" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="Copy" Margin="0,0,8,0" Click="Copy_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Copy" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="Paste" Margin="0,0,8,0" Click="Paste_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentPaste" Width="16" Height="16" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Paste" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="Cut" Margin="0,0,8,0" Click="Cut_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentCut" Width="16" Height="16" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Cut" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="Delete" Margin="0,0,8,0" Click="Delete_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" 
                                                                Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Delete" FontSize="12" Foreground="{DynamicResource MaterialDesignError}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Separator Style="{StaticResource CardDividerStyle}" Orientation="Vertical" Margin="4,0"/>
                    
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="Rename" Margin="0,0,8,0" Click="Rename_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Rename" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="Properties" Margin="0,0,8,0" Click="Properties_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Properties" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Separator Style="{StaticResource CardDividerStyle}" Orientation="Vertical" Margin="4,0"/>
                    
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Content="Search" Margin="0,0,8,0" Click="Search_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Search" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <TextBox Style="{StaticResource TextBoxStyle}" 
                             Width="200" VerticalAlignment="Center" 
                             WaterMarkText="Search this folder..." 
                             WaterMarkForeground="{DynamicResource MaterialDesignDisabled}"/>
                </StackPanel>
            </Border>

            <!-- File List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid Style="{StaticResource DataGridStyle}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          CanUserReorderColumns="True" 
                          CanUserResizeColumns="True" 
                          CanUserSortColumns="True" 
                          SelectionMode="Extended" 
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding IconKind}" Width="16" Height="16" 
                                                                Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTextColumn.CellTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDescription}" Width="Auto"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="Auto"/>
                        <DataGridTextColumn Header="Date Modified" Binding="{Binding LastModified, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto"/>
                    </DataGrid.Columns>
                    
                    <DataGrid.ItemsSource>
                        <x:Array Type="local:FileExplorerItem">
                            <local:FileExplorerItem Name="Documents" IsDirectory="True" IconKind="Folder" TypeDescription="File Folder" Size="0" LastModified="2023-11-10 14:30:00"/>
                            <local:FileExplorerItem Name="Pictures" IsDirectory="True" IconKind="ImageMultiple" TypeDescription="File Folder" Size="0" LastModified="2023-11-08 09:15:00"/>
                            <local:FileExplorerItem Name="Videos" IsDirectory="True" IconKind="Video" TypeDescription="File Folder" Size="0" LastModified="2023-11-05 16:45:00"/>
                            <local:FileExplorerItem Name="Music" IsDirectory="True" IconKind="Music" TypeDescription="File Folder" Size="0" LastModified="2023-11-03 11:20:00"/>
                            <local:FileExplorerItem Name="Downloads" IsDirectory="True" IconKind="Download" TypeDescription="File Folder" Size="0" LastModified="2023-11-12 10:00:00"/>
                            
                            <local:FileExplorerItem Name="Report.pdf" IsDirectory="False" IconKind="FilePdf" TypeDescription="PDF Document" Size="2450000" LastModified="2023-11-10 14:30:00"/>
                            <local:FileExplorerItem Name="Project.docx" IsDirectory="False" IconKind="FileWord" TypeDescription="Word Document" Size="1250000" LastModified="2023-11-09 16:20:00"/>
                            <local:FileExplorerItem Name="Data.xlsx" IsDirectory="False" IconKind="FileExcel" TypeDescription="Excel Spreadsheet" Size="850000" LastModified="2023-11-08 11:15:00"/>
                            <local:FileExplorerItem Name="Image.jpg" IsDirectory="False" IconKind="FileImage" TypeDescription="JPEG Image" Size="3200000" LastModified="2023-11-07 13:40:00"/>
                            <local:FileExplorerItem Name="Screenshot.png" IsDirectory="False" IconKind="FileImage" TypeDescription="PNG Image" Size="1800000" LastModified="2023-11-06 15:30:00"/>
                            <local:FileExplorerItem Name="Video.mp4" IsDirectory="False" IconKind="FileVideo" TypeDescription="MP4 Video" Size="150000000" LastModified="2023-11-05 18:20:00"/>
                            <local:FileExplorerItem Name="Installer.exe" IsDirectory="False" IconKind="Application" TypeDescription="Application" Size="45000000" LastModified="2023-11-04 12:00:00"/>
                            <local:FileExplorerItem Name="Archive.zip" IsDirectory="False" IconKind="ZipDisk" TypeDescription="Compressed Folder" Size="25000000" LastModified="2023-11-03 10:30:00"/>
                            
                            <local:FileExplorerItem Name="Backup" IsDirectory="True" IconKind="Folder" TypeDescription="File Folder" Size="0" LastModified="2023-11-01 09:00:00"/>
                            <local:FileExplorerItem Name="Temp" IsDirectory="True" IconKind="Folder" TypeDescription="File Folder" Size="0" LastModified="2023-10-30 14:15:00"/>
                            <local:FileExplorerItem Name="Notes.txt" IsDirectory="False" IconKind="FileDocument" TypeDescription="Text Document" Size="5000" LastModified="2023-10-28 16:45:00"/>
                            <local:FileExplorerItem Name="Config.json" IsDirectory="False" IconKind="FileCode" TypeDescription="JSON File" Size="15000" LastModified="2023-10-25 10:20:00"/>
                            <local:FileExplorerItem Name="Readme.md" IsDirectory="False" IconKind="FileDocument" TypeDescription="Markdown Document" Size="8000" LastModified="2023-10-22 13:10:00"/>
                        </x:Array>
                    </DataGrid.ItemsSource>
                </DataGrid>
            </ScrollViewer>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource MaterialDesignPaper}" 
                    BorderBrush="{DynamicResource MaterialDesignDividers}" BorderThickness="1,0,0,0" 
                    CornerRadius="0" Padding="8" Margin="0,10,0,0">
                <StatusBar Style="{StaticResource StatusBarStyle}">
                    <StatusBarItem Style="{StaticResource StatusBarItemStyle}">
                        <TextBlock Text="15 items" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StatusBarItem>
                    <StatusBarItem Style="{StaticResource StatusBarItemStyle}">
                        <TextBlock Text="Total Size: 185.5 MB" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StatusBarItem>
                    <StatusBarItem Style="{StaticResource StatusBarItemStyle}">
                        <TextBlock Text="NTFS" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StatusBarItem>
                    <StatusBarItem Style="{StaticResource StatusBarItemStyle}" HorizontalAlignment="Right">
                        <TextBlock Text="Ready" FontSize="12" Foreground="{DynamicResource MaterialDesignSuccess}"/>
                    </StatusBarItem>
                </StatusBar>
            </Border>
        </Grid>
    </Grid>
</Page>

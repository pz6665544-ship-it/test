<Page x:Class="SystemHub.Views.Uninstaller.ProgramsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SystemHub.Views.Uninstaller"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Installed Programs" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Application" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,10,0"/>
                    <TextBlock Text="Installed Programs" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Summary Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Total Programs -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ApplicationMultiple" Width="24" Height="24" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Total Programs" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="85" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Installed" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="System: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="5" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="User: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="80" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Storage Used -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Harddisk" Width="24" Height="24" 
                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Storage Used" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="45.2 GB" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="By Programs" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="35" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource AccentHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Avg Size: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="530 MB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recently Installed -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarPlus" Width="24" Height="24" 
                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Recently Added" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="12" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="In Last 30 Days" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Today: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="This Week: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="5" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Large Programs -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ScaleBalance" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" Margin="0,0,8,0"/>
                            <TextBlock Text="Large Programs" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="25" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" Margin="0,8,0,4"/>
                        <TextBlock Text="&gt; 100 MB" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Total: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="18.5 GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search and Filter -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Search & Filter" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Search and Filter Controls -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0" Style="{StaticResource TextBoxStyle}" 
                                 WaterMarkText="Search programs..." 
                                 WaterMarkForeground="{DynamicResource MaterialDesignDisabled}" 
                                 VerticalAlignment="Center"/>

                        <!-- Category Filter -->
                        <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}" 
                                  Margin="8,0,0,0" Width="150">
                            <ComboBoxItem Content="All Categories" IsSelected="True"/>
                            <ComboBoxItem Content="Productivity"/>
                            <ComboBoxItem Content="Multimedia"/>
                            <ComboBoxItem Content="Utilities"/>
                            <ComboBoxItem Content="Games"/>
                            <ComboBoxItem Content="Development"/>
                            <ComboBoxItem Content="Security"/>
                            <ComboBoxItem Content="Communication"/>
                            <ComboBoxItem Content="Browser"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>

                        <!-- Sort By -->
                        <ComboBox Grid.Column="2" Style="{StaticResource ComboBoxStyle}" 
                                  Margin="8,0,0,0" Width="150">
                            <ComboBoxItem Content="Name (A-Z)" IsSelected="True"/>
                            <ComboBoxItem Content="Name (Z-A)"/>
                            <ComboBoxItem Content="Install Date (Newest)"/>
                            <ComboBoxItem Content="Install Date (Oldest)"/>
                            <ComboBoxItem Content="Size (Largest)"/>
                            <ComboBoxItem Content="Size (Smallest)"/>
                            <ComboBoxItem Content="Last Used (Recent)"/>
                            <ComboBoxItem Content="Last Used (Oldest)"/>
                        </ComboBox>

                        <!-- Size Filter -->
                        <ComboBox Grid.Column="3" Style="{StaticResource ComboBoxStyle}" 
                                  Margin="8,0,0,0" Width="150">
                            <ComboBoxItem Content="All Sizes" IsSelected="True"/>
                            <ComboBoxItem Content="&lt; 10 MB"/>
                            <ComboBoxItem Content="10-100 MB"/>
                            <ComboBoxItem Content="100-500 MB"/>
                            <ComboBoxItem Content="500 MB-1 GB"/>
                            <ComboBoxItem Content="&gt; 1 GB"/>
                        </ComboBox>

                        <!-- Usage Filter -->
                        <ComboBox Grid.Column="4" Style="{StaticResource ComboBoxStyle}" 
                                  Margin="8,0,0,0" Width="150">
                            <ComboBoxItem Content="All Usage" IsSelected="True"/>
                            <ComboBoxItem Content="Never Used"/>
                            <ComboBoxItem Content="Rarely Used"/>
                            <ComboBoxItem Content="Occasionally Used"/>
                            <ComboBoxItem Content="Frequently Used"/>
                        </ComboBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Programs List -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Installed Programs" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Programs DataGrid -->
                    <Grid Grid.Row="1" Margin="16">
                        <DataGrid x:Name="ProgramsDataGrid" Style="{StaticResource DataGridStyle}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False" 
                                  CanUserReorderColumns="True" 
                                  CanUserResizeColumns="True" 
                                  CanUserSortColumns="True" 
                                  SelectionMode="Extended" 
                                  SelectionUnit="FullRow" 
                                  AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource CheckBoxStyle}" 
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="Program" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource MaterialDesignPaper}" 
                                                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                                        BorderThickness="1" CornerRadius="4" Width="32" Height="32" Margin="0,0,8,0">
                                                    <Image Source="{Binding IconPath}" Width="16" Height="16" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image.Fallback>
                                                            <materialDesign:PackIcon Kind="Application" Width="16" Height="16" 
                                                                                    Foreground="{DynamicResource MaterialDesignBody}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Image.Fallback>
                                                    </Image>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="11" 
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="Auto"/>
                                <DataGridTextColumn Header="Install Date" Binding="{Binding InstallDate, StringFormat=yyyy-MM-dd}" Width="Auto"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="Auto"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                                <DataGridTextColumn Header="Last Used" Binding="{Binding LastUsed, StringFormat=yyyy-MM-dd}" Width="Auto"/>
                                
                                <DataGridTemplateColumn Header="Actions" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Content="Uninstall" Tag="{Binding Id}" 
                                                        Click="Uninstall_Click" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                                    CornerRadius="4">
                                                                <materialDesign:PackIcon Kind="TrashCan" Width="14" Height="14" 
                                                                                Foreground="{DynamicResource MaterialDesignError}" 
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Content="Details" Tag="{Binding Id}" 
                                                        Click="Details_Click" Margin="0,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                                    CornerRadius="4">
                                                                <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" 
                                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            
                            </DataGrid.Columns>
                        </DataGrid>
                                </x:Array>
                            </DataGrid.ItemsSource>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" 
                                Content="Uninstall Selected" Margin="0,0,8,8" Click="UninstallSelected_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="TrashCan" Width="24" Height="24" 
                                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Uninstall" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Bulk Uninstall" Margin="0,0,8,8" Click="BulkUninstall_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Bulk" FontSize="12" Foreground="{DynamicResource MaterialDesignError}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Startup Programs" Margin="0,0,8,8" Click="StartupPrograms_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ClockStart" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Startup" FontSize="12" Foreground="{DynamicResource AccentHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Export List" Margin="0,0,8,8" Click="ExportList_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileExport" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Export" FontSize="12" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Settings" Margin="0,0,0,8" Click="Settings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="SystemHub.Views.Uninstaller.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Startup Programs" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ClockStart" Width="32" Height="32" 
                                            Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Startup Programs" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Margin="16">
                    <TextBlock Text="Startup Programs Manager" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="Manage which programs start automatically when Windows boots. Disabling unnecessary startup programs can significantly improve your system's boot time and overall performance." 
                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Summary Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Total Startup Programs -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayList" Width="24" Height="24" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Total Programs" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="12" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Configured" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Enabled Programs -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Power" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,8,0"/>
                            <TextBlock Text="Enabled" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="8" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,8,0,4"/>
                        <TextBlock Text="Active" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Disabled Programs -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PowerOff" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,8,0"/>
                            <TextBlock Text="Disabled" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="4" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,8,0,4"/>
                        <TextBlock Text="Inactive" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Programs List -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Startup Programs List" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="StartupDataGrid" Grid.Row="1" Margin="16" 
                              Style="{StaticResource DataGridStyle}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              CanUserReorderColumns="True" 
                              CanUserResizeColumns="True" 
                              CanUserSortColumns="True" 
                              AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" FontSize="13"/>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" FontSize="12"/>
                            
                            <DataGridTemplateColumn Header="Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,3">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunTime, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Run Count" Binding="{Binding RunCount}" Width="Auto" FontSize="12"/>
                            
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource CardActionButtonStyle}" 
                                                    Tag="{Binding Id}" 
                                                    Click="ToggleStartup_Click" Margin="0,0,4,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <materialDesign:PackIcon x:Name="ToggleIcon" Kind="{Binding ToggleIcon}" Width="14" Height="14" 
                                                                                    Foreground="{Binding ToggleColor}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Style="{StaticResource CardActionButtonStyle}" 
                                                    Tag="{Binding Id}" 
                                                    Click="RunNow_Click" Margin="0,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <materialDesign:PackIcon Kind="Play" Width="14" Height="14" 
                                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Enable All" 
                                Margin="0,0,8,0" Width="100" Click="EnableAll_Click"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Disable All" 
                                Margin="0,0,8,0" Width="100" Click="DisableAll_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh List" 
                                Margin="0,0,8,0" Width="100" Click="RefreshList_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Add New" 
                                Margin="0,0,0,0" Width="100" Click="AddNew_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="SystemHub.Views.Uninstaller.GeekPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Geek Uninstaller" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Wrench" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,0,10,0"/>
                    <TextBlock Text="Geek Uninstaller" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Margin="16">
                    <TextBlock Text="Geek Uninstaller Style Interface" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="This interface mimics the Geek Uninstaller tool, providing a clean and professional interface for removing programs with advanced features like forced removal, leftover cleanup, and registry scanning." 
                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Quick Actions" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Scan Now" 
                                Margin="0,0,8,0" Width="100" Click="ScanNow_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Forced Mode" 
                                Margin="0,0,8,0" Width="100" Click="ForcedMode_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Settings" 
                                Margin="0,0,0,0" Width="100" Click="Settings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Program List with Tabs -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Programs" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1" Margin="16">
                        <TabItem Header="All Programs">
                            <DataGrid x:Name="AllProgramsDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" FontSize="13"/>
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                                    
                                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource CardActionButtonStyle}" Tag="{Binding Id}" Click="Uninstall_Click" Margin="0,0,4,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                                        CornerRadius="4">
                                                                    <materialDesign:PackIcon Kind="TrashCan" Width="14" Height="14" 
                                                                                    Foreground="{DynamicResource MaterialDesignError}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <TabItem Header="Recently Added">
                            <DataGrid x:Name="RecentProgramsDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" FontSize="13"/>
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Install Date" Binding="{Binding InstallDate}" Width="Auto" FontSize="12"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <TabItem Header="Large Programs">
                            <DataGrid x:Name="LargeProgramsDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" FontSize="13"/>
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Batch Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Uninstall Selected" 
                                Margin="0,0,8,0" Width="120" Click="UninstallSelected_Click"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Forced Uninstall" 
                                Margin="0,0,8,0" Width="120" Click="ForcedUninstall_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clean Leftovers" 
                                Margin="0,0,8,0" Width="120" Click="CleanLeftovers_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Export" 
                                Margin="0,0,0,0" Width="100" Click="Export_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="SystemHub.Views.Uninstaller.RevoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Revo Uninstaller" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteEmpty" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,10,0"/>
                    <TextBlock Text="Revo Uninstaller" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Margin="16">
                    <TextBlock Text="Revo Uninstaller Style Interface" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="This interface mimics the Revo Uninstaller tool, providing powerful uninstallation with advanced scanning modes, real-time monitoring, and complete removal of all traces." 
                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Scan Modes -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Scan Modes" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <RadioButton Content="Safe Mode" IsChecked="True" Margin="0,0,12,0" GroupName="ScanMode"/>
                        <RadioButton Content="Moderate Mode" IsChecked="False" Margin="0,0,12,0" GroupName="ScanMode"/>
                        <RadioButton Content="Advanced Mode" IsChecked="False" Margin="0,0,12,0" GroupName="ScanMode"/>
                        <RadioButton Content="Custom Mode" IsChecked="False" Margin="0,0,0,0" GroupName="ScanMode"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Program List -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Installed Programs" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ProgramsDataGrid" Grid.Row="1" Margin="16" 
                              Style="{StaticResource DataGridStyle}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" FontSize="13"/>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                            
                            <DataGridTemplateColumn Header="Mode" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedIndex="0" Width="120">
                                            <ComboBoxItem Content="Built-in"/>
                                            <ComboBoxItem Content="Safe"/>
                                            <ComboBoxItem Content="Moderate"/>
                                            <ComboBoxItem Content="Advanced"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource CardActionButtonStyle}" Tag="{Binding Id}" Click="Uninstall_Click" Margin="0,0,4,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <materialDesign:PackIcon Kind="TrashCan" Width="14" Height="14" 
                                                                                    Foreground="{DynamicResource MaterialDesignError}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Style="{StaticResource CardActionButtonStyle}" Tag="{Binding Id}" Click="HunterMode_Click" Margin="0,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <materialDesign:PackIcon Kind="Target" Width="14" Height="14" 
                                                                                    Foreground="{DynamicResource AccentHueMidBrush}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Real-time Monitoring -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Real-time Monitoring" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <CheckBox Content="Monitor installations" IsChecked="True" Margin="0,0,12,0"/>
                        <CheckBox Content="Monitor uninstallations" IsChecked="True" Margin="0,0,12,0"/>
                        <CheckBox Content="Monitor system changes" IsChecked="False" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Uninstall" 
                                Margin="0,0,8,0" Width="100" Click="UninstallSelected_Click"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Hunter Mode" 
                                Margin="0,0,8,0" Width="120" Click="HunterMode_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Logs" 
                                Margin="0,0,8,0" Width="100" Click="Logs_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Settings" 
                                Margin="0,0,0,0" Width="100" Click="Settings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

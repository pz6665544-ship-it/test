<Page x:Class="SystemHub.Views.Uninstaller.ForcedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Forced Uninstall" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TrashCan" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,10,0"/>
                    <TextBlock Text="Forced Uninstall" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Margin="16">
                    <TextBlock Text="Forced Uninstall Tool" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="Forcefully remove stubborn programs that cannot be uninstalled through normal means. This tool will attempt to remove all program files, registry entries, and shortcuts." 
                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                               TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource MaterialDesignErrorLight}" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20" 
                                                    Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,8,0"/>
                            <TextBlock Text="WARNING: Forced uninstall may cause system instability. Use with caution." 
                                       FontSize="12" Foreground="{DynamicResource MaterialDesignError}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Program Selection -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Select Program" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ComboBox x:Name="ProgramComboBox" Grid.Row="0" Style="{StaticResource ComboBoxStyle}" 
                                  Width="400" HorizontalAlignment="Left" 
                                  DisplayMemberPath="DisplayName" SelectedIndex="0"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Force Uninstall" 
                                    Width="150" Click="ForceUninstall_Click"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clean Leftovers" 
                                    Margin="8,0,0,0" Width="150" Click="CleanLeftovers_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Options -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Uninstall Options" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1">
                        <CheckBox Content="Remove program files and folders" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox Content="Remove registry entries" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox Content="Remove shortcuts and start menu entries" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox Content="Remove scheduled tasks" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox Content="Remove service entries" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox Content="Create system restore point before uninstalling" IsChecked="False" Margin="0,0,0,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress and Log -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocument" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Uninstall Log" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBox x:Name="LogTextBox" AcceptsReturn="True" IsReadOnly="True" 
                                 Background="{DynamicResource MaterialDesignPaper}" 
                                 BorderThickness="0" Padding="8" 
                                 FontFamily="Consolas" FontSize="12" 
                                 Foreground="{DynamicResource MaterialDesignBody}" 
                                 TextWrapping="Wrap" Height="200" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="SystemHub.Views.SystemInfo.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SystemHub.Views.SystemInfo"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="System Overview" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Monitor" Width="32" Height="32" 
                                            Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="System Overview" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- System Summary Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="24" Height="24" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="Intel Core i9-12900H" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="25.5% Usage" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="25.5" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Cores: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="14" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="Threads: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="20" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Temp: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="45.2°C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Memory Card -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="24" Height="24" 
                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="32 GB DDR5" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="65.3% Used" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="65.3" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource AccentHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Total: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="32 GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="Speed: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="4800 MHz" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Used: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="20.9 GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Harddisk" Width="24" Height="24" 
                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Storage" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="Samsung 980 PRO" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="45.2% Used" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="45.2" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource SecondaryHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Type: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="NVMe SSD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="Size: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="1 TB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Temp: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="35°C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DesktopTower" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" Margin="0,0,8,0"/>
                            <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="RTX 3050 Ti" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="15.8% Usage" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="15.8" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="VRAM: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="4 GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="Type: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="GDDR6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Temp: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="45°C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System Information Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="System Information" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- System Info Grid -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer Name:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="DESKTOP-PC" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="User:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="SystemUser" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="OS:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Windows 11 Pro (22H2)" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Build:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="22621.2428" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Row 3 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="System Type:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="64-bit Operating System, x64-based processor" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="BIOS:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Dell Inc. 1.20.0" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Row 4 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Manufacturer:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Dell Inc." 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Model:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="XPS 15 9520" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Row 5 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Uptime:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="48 hours, 15 minutes" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Last Boot:" 
                                   FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="2023-11-15 08:30:00" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Row 6 -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="System Serial:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="ABC123XYZ" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Activation:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Activated" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Performance Charts Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Performance Metrics" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Charts -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Usage Chart -->
                        <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                            <StackPanel>
                                <TextBlock Text="CPU Usage Over Time" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,12"/>
                                <!-- Placeholder for LiveCharts2 chart -->
                                <Border Background="{DynamicResource MaterialDesignPaper}" 
                                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                        BorderThickness="1" CornerRadius="4" Height="200">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Cpu64Bit" Width="48" Height="48" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="CPU Usage Chart" FontSize="14" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                                        <TextBlock Text="(LiveCharts2 integration placeholder)" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Current: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="25.5%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Avg: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="22.3%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Max: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="45.2%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignError}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Memory Usage Chart -->
                        <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Memory Usage Over Time" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,12"/>
                                <!-- Placeholder for LiveCharts2 chart -->
                                <Border Background="{DynamicResource MaterialDesignPaper}" 
                                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                        BorderThickness="1" CornerRadius="4" Height="200">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Memory" Width="48" Height="48" 
                                                                Foreground="{DynamicResource AccentHueMidBrush}" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Memory Usage Chart" FontSize="14" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                                        <TextBlock Text="(LiveCharts2 integration placeholder)" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Current: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="65.3%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentHueMidBrush}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Total: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="32 GB" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Used: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="20.9 GB" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- System Resources Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Server" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="System Resources" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Resources Grid -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Processes -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Application" Width="20" Height="20" 
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Processes" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="128" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text="Running" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Threads -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Thread" Width="20" Height="20" 
                                                            Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Threads" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="2456" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text="Active" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Handles -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocument" Width="20" Height="20" 
                                                            Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Handles" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="18500" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text="Open" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- GDI Objects -->
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Palette" Width="20" Height="20" 
                                                            Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" Margin="0,0,8,0"/>
                                    <TextBlock Text="GDI Objects" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="4500" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" Margin="0,8,0,0"/>
                                <TextBlock Text="Active" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Network Overview Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Ethernet" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Network Overview" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Info -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="250"/>
                            <ColumnDefinition Width="*" MinWidth="250"/>
                            <ColumnDefinition Width="*" MinWidth="250"/>
                        </Grid.ColumnDefinitions>

                        <!-- Wi-Fi Adapter -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Wifi" Width="20" Height="20" 
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Wi-Fi 6" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="Connected" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,4,0,8"/>
                                <Separator Style="{StaticResource CardDividerStyle}"/>
                                <StackPanel>
                                    <TextBlock Text="IP Address:" FontSize="11" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,2"/>
                                    <TextBlock Text="192.168.1.100" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                    <TextBlock Text="SSID:" FontSize="11" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,2"/>
                                    <TextBlock Text="MyWiFiNetwork" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Signal:" FontSize="11" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Excellent" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ethernet Adapter -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EthernetCable" Width="20" Height="20" 
                                                            Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ethernet" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="Disconnected" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,8"/>
                                <Separator Style="{StaticResource CardDividerStyle}"/>
                                <StackPanel>
                                    <TextBlock Text="Status:" FontSize="11" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Cable Unplugged" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Speed:" FontSize="11" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,2"/>
                                    <TextBlock Text="N/A" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Network Stats -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Network" Width="20" Height="20" 
                                                            Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Network Stats" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Download" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Text="50.2 Mbps" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                    </StackPanel>
                                    <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Upload" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Text="10.5 Mbps" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Today" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Text="12.5 GB" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </StackPanel>
                                    <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="This Month" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Text="250 GB" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Actions Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" 
                                Content="Refresh" Margin="0,0,8,8" Click="Refresh_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24" 
                                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Refresh" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="System Info" Margin="0,0,8,8" Click="SystemInfo_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="InformationOutline" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="System Info" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Performance" Margin="0,0,8,8" Click="Performance_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Speedometer" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Performance" FontSize="12" Foreground="{DynamicResource AccentHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Network" Margin="0,0,8,8" Click="Network_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Ethernet" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Network" FontSize="12" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Settings" Margin="0,0,0,8" Click="Settings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

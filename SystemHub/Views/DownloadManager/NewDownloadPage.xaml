<Page x:Class="SystemHub.Views.DownloadManager.NewDownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="New Download" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignPrimary}" Margin="0,0,10,0"/>
                    <TextBlock Text="New Download" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- URL Input -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Download URL" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <TextBox Grid.Row="1" x:Name="UrlTextBox" Style="{StaticResource TextBoxStyle}" 
                             WaterMarkText="Enter URL (e.g., https://example.com/file.zip)" 
                             WaterMarkForeground="{DynamicResource MaterialDesignDisabled}" 
                             VerticalAlignment="Center" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Paste URL" 
                                Margin="0,0,8,0" Width="100" Click="PasteUrl_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear" 
                                Margin="0,0,0,0" Width="80" Click="ClearUrl_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File Information -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="File Information" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Save to:" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                   VerticalAlignment="Center" Width="100"/>
                        <TextBox x:Name="SavePathTextBox" Style="{StaticResource TextBoxStyle}" 
                                 Text="C:\\Downloads" Width="300" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Browse..." 
                                Margin="8,0,0,0" Width="80" Click="Browse_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="File name:" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                   VerticalAlignment="Center" Width="100"/>
                        <TextBox x:Name="FileNameTextBox" Style="{StaticResource TextBoxStyle}" 
                                 WaterMarkText="Auto-generated from URL" 
                                 WaterMarkForeground="{DynamicResource MaterialDesignDisabled}" 
                                 Width="300" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Category:" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                   VerticalAlignment="Center" Width="100"/>
                        <ComboBox x:Name="CategoryComboBox" Style="{StaticResource ComboBoxStyle}" 
                                  Width="300" VerticalAlignment="Center">
                            <ComboBoxItem Content="General" IsSelected="True"/>
                            <ComboBoxItem Content="Software"/>
                            <ComboBoxItem Content="Games"/>
                            <ComboBoxItem Content="Videos"/>
                            <ComboBoxItem Content="Music"/>
                            <ComboBoxItem Content="Documents"/>
                            <ComboBoxItem Content="Drivers"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="Priority:" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                   VerticalAlignment="Center" Width="100"/>
                        <ComboBox x:Name="PriorityComboBox" Style="{StaticResource ComboBoxStyle}" 
                                  Width="300" VerticalAlignment="Center">
                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Download Options -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Download Options" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1">
                        <CheckBox Content="Start download immediately" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox Content="Download in parts" IsChecked="False" Margin="0,0,0,8"/>
                        <CheckBox Content="Verify checksum after download" IsChecked="False" Margin="0,0,0,8"/>
                        <CheckBox Content="Shutdown computer when finished" IsChecked="False" Margin="0,0,0,8"/>
                        <CheckBox Content="Use proxy server" IsChecked="False" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Connection Settings -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Connection Settings" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Max connections:" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                   VerticalAlignment="Center" Width="120"/>
                        <Slider x:Name="ConnectionsSlider" Width="200" Minimum="1" Maximum="16" Value="8" 
                                Style="{StaticResource SliderStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionsValueText" Text="8" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                   VerticalAlignment="Center" Margin="8,0,0,0" Width="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="Download speed limit:" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                   VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="SpeedLimitTextBox" Style="{StaticResource TextBoxStyle}" 
                                 WaterMarkText="Unlimited" 
                                 WaterMarkForeground="{DynamicResource MaterialDesignDisabled}" 
                                 Width="150" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SpeedUnitComboBox" Style="{StaticResource ComboBoxStyle}" 
                                  Width="80" Margin="8,0,0,0" VerticalAlignment="Center">
                            <ComboBoxItem Content="KB/s" IsSelected="True"/>
                            <ComboBoxItem Content="MB/s"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" 
                                Margin="0,0,8,0" Width="100" Click="Cancel_Click"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Start Download" 
                                Margin="0,0,0,0" Width="150" Click="StartDownload_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

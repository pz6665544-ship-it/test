<Page x:Class="SystemHub.Views.Dashboard.SystemHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SystemHub.Views.Dashboard"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="System Health" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HeartPulse" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,10,0"/>
                    <TextBlock Text="System Health Monitor" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Overall Health Score -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Star" Width="20" Height="20" 
                                                    Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,8,0"/>
                            <TextBlock Text="Overall Health Score" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Health Score Display -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="Auto" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Gauge -->
                        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" 
                                BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                BorderThickness="1" CornerRadius="50" Width="150" Height="150">
                            <Grid>
                                <!-- Outer ring -->
                                <Ellipse Width="140" Height="140" Stroke="{DynamicResource MaterialDesignDividers}" 
                                         StrokeThickness="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Progress ring -->
                                <Path Stroke="{DynamicResource MaterialDesignSuccess}" StrokeThickness="8" 
                                      StrokeDashArray="314,1000" StrokeDashOffset="0" 
                                      StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Data>
                                        <EllipseGeometry RadiusX="70" RadiusY="70" Center="70,70"/>
                                    </Path.Data>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="StrokeDashOffset">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1" Value="-220"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                                <!-- Inner content -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="95%" FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Excellent" FontSize="14" 
                                               Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Details -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Your system is in excellent health!" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,0,8"/>
                            <TextBlock Text="All components are operating within normal parameters. No immediate issues detected." 
                                       FontSize="13" Foreground="{DynamicResource MaterialDesignBody}" 
                                       TextWrapping="Wrap" Margin="0,0,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" 
                                                        Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                <TextBlock Text="Last checked: 2 minutes ago" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quick Stats -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="16,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" 
                                                            Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Issues Found:" FontSize="12" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>
                                <TextBlock Text="0" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16" 
                                                            Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Warnings:" FontSize="12" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>
                                <TextBlock Text="0" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignWarning}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" 
                                                            Foreground="{DynamicResource MaterialDesignInfo}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Recommendations:" FontSize="12" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>
                                <TextBlock Text="3" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignInfo}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Component Health Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Component Health" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Component Health Grid -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Health -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cpu64Bit" Width="20" Height="20" 
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="Intel Core i9-12900H" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ProgressBar Value="98" Maximum="100" Height="8" CornerRadius="4"
                                                 Foreground="{DynamicResource MaterialDesignSuccess}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="60"/>
                                    <TextBlock Text="98%" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Temperature: 45°C" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Usage: 25.5%" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Status: Excellent" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Memory Health -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Memory" Width="20" Height="20" 
                                                            Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="32 GB DDR5" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ProgressBar Value="95" Maximum="100" Height="8" CornerRadius="4"
                                                 Foreground="{DynamicResource MaterialDesignSuccess}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="60"/>
                                    <TextBlock Text="95%" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Usage: 65.3%" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Speed: 4800 MHz" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Status: Excellent" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Storage Health -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Harddisk" Width="20" Height="20" 
                                                            Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Storage" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="Samsung 980 PRO 1TB" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ProgressBar Value="95" Maximum="100" Height="8" CornerRadius="4"
                                                 Foreground="{DynamicResource MaterialDesignSuccess}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="60"/>
                                    <TextBlock Text="95%" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Usage: 45.2%" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Health: 95%" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Status: Excellent" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Health -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DesktopTower" Width="20" Height="20" 
                                                            Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" Margin="0,0,8,0"/>
                                    <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="NVIDIA RTX 3050 Ti" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ProgressBar Value="98" Maximum="100" Height="8" CornerRadius="4"
                                                 Foreground="{DynamicResource MaterialDesignSuccess}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="60"/>
                                    <TextBlock Text="98%" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Temperature: 45°C" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Usage: 15.8%" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Status: Excellent" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Motherboard Health -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Chip" Width="20" Height="20" 
                                                            Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Motherboard" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="Dell XPS 15 9520" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ProgressBar Value="97" Maximum="100" Height="8" CornerRadius="4"
                                                 Foreground="{DynamicResource MaterialDesignSuccess}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="60"/>
                                    <TextBlock Text="97%" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Temperature: 38°C" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="BIOS: 1.20.0" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Status: Excellent" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Network Health -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Wifi" Width="20" Height="20" 
                                                            Foreground="{DynamicResource MaterialDesignInfo}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Network" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="Intel Wi-Fi 6 AX210" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ProgressBar Value="90" Maximum="100" Height="8" CornerRadius="4"
                                                 Foreground="{DynamicResource MaterialDesignSuccess}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="60"/>
                                    <TextBlock Text="90%" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignSuccess}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Signal: Excellent" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Speed: 866 Mbps" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="Status: Excellent" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Temperature Monitoring Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Thermometer" Width="20" Height="20" 
                                                    Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,8,0"/>
                            <TextBlock Text="Temperature Monitoring" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Temperature Sensors -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sensor 1 -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="CPU Package" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="45.2°C" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Normal" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="45.2" Maximum="100" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource MaterialDesignSuccess}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Sensor 2 -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="CPU Core 1" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="42.8°C" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Normal" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="42.8" Maximum="100" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource MaterialDesignSuccess}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Sensor 3 -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="CPU Core 2" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="43.5°C" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Normal" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="43.5" Maximum="100" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource MaterialDesignSuccess}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Sensor 4 -->
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="GPU Core" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="45.0°C" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Normal" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="45.0" Maximum="100" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource MaterialDesignSuccess}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Sensor 5 -->
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="System" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="38.5°C" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Normal" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="38.5" Maximum="80" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource MaterialDesignSuccess}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Fan Speed Monitoring Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Fan" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Fan Speed Monitoring" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Fan Sensors -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- Fan 1 -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CPU Fan" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="1200 RPM" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="30%" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="30" Maximum="100" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fan 2 -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="GPU Fan" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="1500 RPM" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="35%" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="35" Maximum="100" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fan 3 -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="System Fan" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="1000 RPM" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="25%" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
                                <ProgressBar Value="25" Maximum="100" Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                             Background="{DynamicResource MaterialDesignDividers}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fan Speed Chart Placeholder -->
                        <Border Grid.Column="3" Style="{StaticResource ChartCardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Fan Speed Chart" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,12"/>
                                <Border Background="{DynamicResource MaterialDesignPaper}" 
                                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                        BorderThickness="1" CornerRadius="4" Height="120">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Fan" Width="32" Height="32" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Fan Speed Chart" FontSize="12" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0"/>
                                        <TextBlock Text="(LiveCharts2 integration placeholder)" FontSize="8" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Recommendations Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightbulbOn" Width="20" Height="20" 
                                                    Foreground="{DynamicResource MaterialDesignInfo}" Margin="0,0,8,0"/>
                            <TextBlock Text="Recommendations" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Recommendations List -->
                    <Grid Grid.Row="1" Margin="16">
                        <ListView Style="{StaticResource ListViewStyle}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="4" Padding="8">
                                                    <ContentPresenter Content="{TemplateBinding Content}" 
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource MaterialDesignInfo}" 
                                                BorderBrush="{DynamicResource MaterialDesignInfo}" 
                                                BorderThickness="1" CornerRadius="50" Width="32" Height="32" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="LightbulbOn" Width="18" Height="18" 
                                                                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Priority}" FontSize="11" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            
                            <ListView.Items>
                                <local:RecommendationItem Title="Update GPU Drivers" 
                                        Description="New NVIDIA drivers are available (version 537.58). Current: 536.99" 
                                        Priority="High"/>
                                <local:RecommendationItem Title="Enable Hardware Acceleration" 
                                        Description="Hardware acceleration is disabled in some applications. Enable it for better performance." 
                                        Priority="Medium"/>
                                <local:RecommendationItem Title="Clean Temporary Files" 
                                        Description="5.2 GB of temporary files can be safely deleted to free up disk space." 
                                        Priority="Low"/>
                                <local:RecommendationItem Title="Optimize Startup Programs" 
                                        Description="You have 8 programs starting with Windows. Consider disabling unnecessary startup programs." 
                                        Priority="Medium"/>
                                <local:RecommendationItem Title="Check for Windows Updates" 
                                        Description="Windows Update has 3 optional updates available for installation." 
                                        Priority="Low"/>
                            </ListView.Items>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Health Check Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" 
                                Content="Run Full Scan" Margin="0,0,8,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="MagnifyScan" Width="24" Height="24" 
                                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Full Scan" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Quick Check" Margin="0,0,8,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ClockFast" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Quick Check" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Export Report" Margin="0,0,8,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileExport" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Export" FontSize="12" Foreground="{DynamicResource AccentHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="View History" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="History" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="History" FontSize="12" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="SystemHub.Views.Dashboard.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SystemHub.Views.Dashboard"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Dashboard Overview" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="32" Height="32" 
                                            Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Dashboard Overview" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Quick Stats Row -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- System Health Score -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Heart" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,8,0"/>
                            <TextBlock Text="System Health" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="95%" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,8,0,4"/>
                        <TextBlock Text="Excellent" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="95" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource MaterialDesignSuccess}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Last Check: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="2 minutes ago" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Performance Score -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Speedometer" Width="24" Height="24" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Performance" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="88%" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Very Good" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="88" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Score: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="4.2/5.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Security Score -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,0,8,0"/>
                            <TextBlock Text="Security" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="75%" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,8,0,4"/>
                        <TextBlock Text="Good" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="75" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource MaterialDesignWarning}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Threats: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignSuccess}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Storage Usage -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Harddisk" Width="24" Height="24" 
                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Storage" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="45%" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Used" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="45" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource AccentHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Total: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="1.8 TB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System Status Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Status -->
                <Border Grid.Column="0" Style="{StaticResource CardWithShadowStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="Intel Core i9-12900H" FontSize="14" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="25.5% Usage" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="25.5" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Cores" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="14" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Threads" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="20" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Temp" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="45°C" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Memory Status -->
                <Border Grid.Column="1" Style="{StaticResource CardWithShadowStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="20" Height="20" 
                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="32 GB DDR5" FontSize="14" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="65.3% Used" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="65.3" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource AccentHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Total" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="32 GB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Used" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="20.9 GB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Speed" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="4800 MHz" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Disk Status -->
                <Border Grid.Column="2" Style="{StaticResource CardWithShadowStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Harddisk" Width="20" Height="20" 
                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Disk" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="Samsung 980 PRO" FontSize="14" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="45.2% Used" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="45.2" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource SecondaryHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Type" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="NVMe" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Size" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="1 TB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Health" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="95%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignSuccess}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU Status -->
                <Border Grid.Column="3" Style="{StaticResource CardWithShadowStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DesktopTower" Width="20" Height="20" 
                                                    Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" Margin="0,0,8,0"/>
                            <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="RTX 3050 Ti" FontSize="14" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,4"/>
                        <TextBlock Text="15.8% Usage" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="15.8" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="VRAM" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="4 GB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Temp" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="45°C" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Driver" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="536.99" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Resource Usage Charts -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Resource Usage" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Charts -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Usage Chart -->
                        <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                            <StackPanel>
                                <TextBlock Text="CPU Usage" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,12"/>
                                <Border Background="{DynamicResource MaterialDesignPaper}" 
                                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                        BorderThickness="1" CornerRadius="4" Height="200">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Cpu64Bit" Width="48" Height="48" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="CPU Usage Chart" FontSize="14" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                                        <TextBlock Text="(LiveCharts2 integration placeholder)" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Current: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="25.5%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Avg: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="22.3%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Max: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="45.2%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignError}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Memory Usage Chart -->
                        <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Memory Usage" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,12"/>
                                <Border Background="{DynamicResource MaterialDesignPaper}" 
                                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                        BorderThickness="1" CornerRadius="4" Height="200">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Memory" Width="48" Height="48" 
                                                                Foreground="{DynamicResource AccentHueMidBrush}" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Memory Usage Chart" FontSize="14" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                                        <TextBlock Text="(LiveCharts2 integration placeholder)" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Current: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="65.3%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentHueMidBrush}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Total: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="32 GB" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock Text=" | " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Used: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="20.9 GB" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- System Information Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="System Information" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- System Info Grid -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer Name:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="DESKTOP-PC" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="User:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="SystemUser" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="OS:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Windows 11 Pro (22H2)" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Build:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="22621.2428" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Row 3 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="System Type:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="64-bit Operating System, x64-based processor" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Uptime:" 
                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="48 hours, 15 minutes" 
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Actions Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" 
                                Content="Refresh" Margin="0,0,8,8" Click="Refresh_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24" 
                                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Refresh" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="System Info" Margin="0,0,8,8" Click="SystemInfo_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">

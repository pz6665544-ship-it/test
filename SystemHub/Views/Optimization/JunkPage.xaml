<Page x:Class="SystemHub.Views.Optimization.JunkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Junk Files Cleanup" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteSweep" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,0,10,0"/>
                    <TextBlock Text="Junk Files Cleanup" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Margin="16">
                    <TextBlock Text="Junk Files Cleanup" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="Clean up temporary files, cache, old downloads, and other junk that accumulates over time. This tool will scan for various types of unnecessary files and allow you to safely remove them to free up disk space." 
                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Scan Options -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Scan Options" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Scan Now" 
                                Margin="0,0,8,0" Width="120" Click="ScanNow_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Scan System Temp" 
                                Margin="0,0,8,0" Width="140" Click="ScanSystemTemp_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Scan User Temp" 
                                Margin="0,0,8,0" Width="140" Click="ScanUserTemp_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Scan Browser Cache" 
                                Margin="0,0,0,0" Width="140" Click="ScanBrowserCache_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scan Progress -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20" Visibility="Collapsed" x:Name="ScanProgressBorder">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Scanning for junk files..." FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    
                    <ProgressBar Grid.Row="1" Value="0" Maximum="100" Height="8" CornerRadius="4" 
                                 Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                 Background="{DynamicResource MaterialDesignDividers}" x:Name="ScanProgressBar"/>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="ScanStatusText" Text="Initializing scan..." FontSize="13" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="ScanItemsFoundText" Text="" FontSize="13" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20" Visibility="Collapsed" x:Name="ResultsBorder">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileFind" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Scan Results" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ResultsDataGrid" Grid.Row="1" Margin="16" 
                              Style="{StaticResource DataGridStyle}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="Type" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16" 
                                                                    Foreground="{Binding Color}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" FontSize="12"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="Auto" FontSize="12"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Summary -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20" Visibility="Collapsed" x:Name="SummaryBorder">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cleanup Summary" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Total Items:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="TotalItemsText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Total Size:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="TotalSizeText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentHueMidBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Selected:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="SelectedItemsText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Space to Free:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="SpaceToFreeText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource MaterialDesignSuccess}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Clean Selected" 
                                Margin="0,0,8,0" Width="120" Click="CleanSelected_Click"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Clean All" 
                                Margin="0,0,8,0" Width="100" Click="CleanAll_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Select All" 
                                Margin="0,0,8,0" Width="100" Click="SelectAll_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Select None" 
                                Margin="0,0,8,0" Width="100" Click="SelectNone_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" 
                                Margin="0,0,0,0" Width="100" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

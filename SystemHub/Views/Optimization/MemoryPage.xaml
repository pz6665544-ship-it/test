<Page x:Class="SystemHub.Views.Optimization.MemoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Memory Optimization" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Memory" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignPrimary}" Margin="0,0,10,0"/>
                    <TextBlock Text="Memory Optimization" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Margin="16">
                    <TextBlock Text="Memory Optimization Tool" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="Optimize your system's memory usage by freeing up RAM, managing running processes, and configuring memory settings. This tool helps improve system responsiveness and prevent slowdowns." 
                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Memory Status Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Total Memory -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chip" Width="24" Height="24" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Total Memory" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="32 GB" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Installed" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="65" Maximum="100" Height="6" CornerRadius="3" 
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Used Memory -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,0,8,0"/>
                            <TextBlock Text="Used Memory" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="20.8 GB" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,8,0,4"/>
                        <TextBlock Text="65%" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Working Set: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="18.5 GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Available Memory -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,8,0"/>
                            <TextBlock Text="Available" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="11.2 GB" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,8,0,4"/>
                        <TextBlock Text="35%" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Free: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="11.2 GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Optimize Now" 
                                Margin="0,0,8,0" Width="120" Click="OptimizeNow_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="LightningBolt" Width="24" Height="24" 
                                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Optimize" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear Cache" 
                                Margin="0,0,8,0" Width="120" Click="ClearCache_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Broom" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Clear" FontSize="12" Foreground="{DynamicResource MaterialDesignWarning}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Defragment" 
                                Margin="0,0,8,0" Width="120" Click="Defragment_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Defragment" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Defrag" FontSize="12" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Settings" 
                                Margin="0,0,0,0" Width="100" Click="Settings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Process List -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Running Processes" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ProcessesDataGrid" Grid.Row="1" Margin="16" 
                              Style="{StaticResource DataGridStyle}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" FontSize="13"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="Auto" FontSize="12"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" FontSize="12"/>
                            
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource CardActionButtonStyle}" Tag="{Binding Id}" Click="EndProcess_Click" Margin="0,0,4,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <materialDesign:PackIcon Kind="Stop" Width="14" Height="14" 
                                                                                    Foreground="{DynamicResource MaterialDesignError}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Style="{StaticResource CardActionButtonStyle}" Tag="{Binding Id}" Click="ProcessInfo_Click" Margin="0,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" 
                                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Memory Chart Placeholder -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Memory Usage Over Time" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <!-- Chart placeholder - would use LiveCharts2 in full implementation -->
                    <Border Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}" 
                            BorderBrush="{DynamicResource MaterialDesignDividers}" 
                            BorderThickness="1" CornerRadius="4" Height="200">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartLine" Width="48" Height="48" 
                                                    Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                            <TextBlock Text="Memory usage chart would be displayed here" FontSize="13" 
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

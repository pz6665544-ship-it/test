<Page x:Class="SystemHub.Views.Optimization.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="System Cleanup" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Broom" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignWarning}" Margin="0,0,10,0"/>
                    <TextBlock Text="System Cleanup" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Margin="16">
                    <TextBlock Text="System Cleanup Tool" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="Clean up junk files, temporary data, and unnecessary items to free up disk space and improve system performance. This tool will scan for various types of system clutter and allow you to safely remove them." 
                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Quick Scan -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Quick Scan" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Scan Now" 
                                Margin="0,0,8,0" Width="120" Click="QuickScan_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Deep Scan" 
                                Margin="0,0,8,0" Width="120" Click="DeepScan_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Custom Scan" 
                                Margin="0,0,0,0" Width="120" Click="CustomScan_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scan Progress -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20" Visibility="Collapsed" x:Name="ScanProgressBorder">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Scanning System..." FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    
                    <ProgressBar Grid.Row="1" Value="0" Maximum="100" Height="8" CornerRadius="4" 
                                 Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                 Background="{DynamicResource MaterialDesignDividers}" x:Name="ScanProgressBar"/>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="ScanStatusText" Text="Initializing scan..." FontSize="13" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="ScanItemsFoundText" Text="" FontSize="13" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scan Results -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20" Visibility="Collapsed" x:Name="ResultsBorder">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileFind" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Scan Results" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1" Margin="16">
                        <TabItem Header="All Items">
                            <DataGrid x:Name="AllItemsDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" FontSize="12"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified}" Width="Auto" FontSize="12"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <TabItem Header="Temporary Files">
                            <DataGrid x:Name="TempFilesDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" FontSize="12"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" FontSize="12"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <TabItem Header="Cache Files">
                            <DataGrid x:Name="CacheFilesDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" FontSize="12"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <TabItem Header="Logs">
                            <DataGrid x:Name="LogsDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Log File" Binding="{Binding FileName}" Width="*" FontSize="12"/>
                                    <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" FontSize="12"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding LastModified}" Width="Auto" FontSize="12"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <TabItem Header="Empty Folders">
                            <DataGrid x:Name="EmptyFoldersDataGrid" Style="{StaticResource DataGridStyle}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      AlternatingRowBackground="{DynamicResource MaterialDesignHover}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Folder" Binding="{Binding Location}" Width="*" FontSize="12"/>
                                    <DataGridTextColumn Header="Date Created" Binding="{Binding LastModified}" Width="Auto" FontSize="12"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Clean Selected" 
                                Margin="0,0,8,0" Width="120" Click="CleanSelected_Click"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Clean All" 
                                Margin="0,0,8,0" Width="120" Click="CleanAll_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Select All" 
                                Margin="0,0,8,0" Width="100" Click="SelectAll_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Select None" 
                                Margin="0,0,8,0" Width="100" Click="SelectNone_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" 
                                Margin="0,0,0,0" Width="100" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20" Visibility="Collapsed" x:Name="SummaryBorder">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cleanup Summary" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Total Items Found:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="TotalItemsText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Total Size:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="TotalSizeText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Items Selected:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="SelectedItemsText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentHueMidBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Space to Free:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="SpaceToFreeText" Text="0" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource MaterialDesignSuccess}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back" Margin="0,0,8,0" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

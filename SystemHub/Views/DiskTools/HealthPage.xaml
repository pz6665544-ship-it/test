<Page x:Class="SystemHub.Views.DiskTools.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SystemHub.Views.DiskTools"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Disk Health" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HeartPulse" Width="32" Height="32" 
                                            Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,10,0"/>
                    <TextBlock Text="Disk Health Monitor" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Health Summary -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Health Summary" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary Grid -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Overall Health -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Overall Health" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="88%" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Good" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Disks Monitored -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Disks Monitored" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="3" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Physical" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Issues Found -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Issues Found" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="1" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignError}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Critical" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Warnings -->
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Warnings" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                <TextBlock Text="2" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignWarning}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Medium" FontSize="12" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Disk Health Details -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Harddisk" Width="20" Height="20" 
                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Disk Health Details" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Disk List -->
                    <Grid Grid.Row="1" Margin="16">
                        <ListView Style="{StaticResource ListViewStyle}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                    <ContentPresenter Content="{TemplateBinding Content}" 
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Disk Icon -->
                                        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" 
                                                BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                                BorderThickness="1" CornerRadius="8" Width="56" Height="56" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Harddisk" Width="28" Height="28" 
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" 
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Disk Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DiskName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                                            <TextBlock Text="{Binding DiskId}" FontSize="11" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding InterfaceType}" FontSize="10" 
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text=" | " FontSize="10" 
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding MediaType}" FontSize="10" 
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Health Badge -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <Border Background="{Binding HealthColor}" 
                                                    BorderBrush="{Binding HealthColor}" 
                                                    BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                <TextBlock Text="{Binding HealthStatus}" FontSize="12" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding HealthPercentage}%" FontSize="11" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- Temperature -->
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Temperature}°C" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                                            <TextBlock Text="Temp" FontSize="10" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>
                                        
                                        <!-- Actions -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource CardActionButtonStyle}" 
                                                    Content="Details" Tag="{Binding DiskId}" 
                                                    Click="ViewDiskDetails_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                                       Foreground="{TemplateBinding Foreground}" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                       Padding="4,2"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Style="{StaticResource CardActionButtonStyle}" 
                                                    Content="SMART" Tag="{Binding DiskId}" 
                                                    Click="ViewSmartData_Click" Margin="4,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                                       Foreground="{TemplateBinding Foreground}" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                       Padding="4,2"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            
                            <ListView.ItemsSource>
                                <x:Array Type="local:DiskHealthItem">
                                    <local:DiskHealthItem 
                                        DiskId="\\\\.\\PHYSICALDRIVE0" 
                                        DiskName="Samsung SSD 980 PRO 1TB" 
                                        InterfaceType="NVMe" 
                                        MediaType="SSD" 
                                        HealthStatus="Good" 
                                        HealthPercentage="95" 
                                        HealthColor="{DynamicResource MaterialDesignSuccess}" 
                                        Temperature="35"/>
                                    <local:DiskHealthItem 
                                        DiskId="\\\\.\\PHYSICALDRIVE1" 
                                        DiskName="Seagate Barracuda 2TB" 
                                        InterfaceType="SATA" 
                                        MediaType="HDD" 
                                        HealthStatus="Warning" 
                                        HealthPercentage="75" 
                                        HealthColor="{DynamicResource MaterialDesignWarning}" 
                                        Temperature="42"/>
                                    <local:DiskHealthItem 
                                        DiskId="\\\\.\\PHYSICALDRIVE2" 
                                        DiskName="SanDisk Ultra 128GB" 
                                        InterfaceType="USB" 
                                        MediaType="SSD" 
                                        HealthStatus="Good" 
                                        HealthPercentage="98" 
                                        HealthColor="{DynamicResource MaterialDesignSuccess}" 
                                        Temperature="0"/>
                                </x:Array>
                            </ListView.ItemsSource>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- SMART Data Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocument" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="SMART Data" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- SMART Data Grid -->
                    <Grid Grid.Row="1" Margin="16">
                        <DataGrid Style="{StaticResource DataGridStyle}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False" 
                                  CanUserReorderColumns="True" 
                                  CanUserResizeColumns="True" 
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Attribute" Binding="{Binding AttributeName}" Width="*"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding AttributeId}" Width="Auto"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="Auto"/>
                                <DataGridTextColumn Header="Worst" Binding="{Binding Worst}" Width="Auto"/>
                                <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="Auto"/>
                                <DataGridTextColumn Header="Raw Value" Binding="{Binding RawValue}" Width="Auto"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource StatusToColorConverter}">
                                                        <Binding Path="Status"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            
                            <DataGrid.ItemsSource>
                                <x:Array Type="local:SmartDataItem">
                                    <local:SmartDataItem AttributeId="1" AttributeName="Raw Read Error Rate" Value="100" Worst="100" Threshold="50" RawValue="0" Status="Good"/>
                                    <local:SmartDataItem AttributeId="3" AttributeName="Spin Up Time" Value="100" Worst="100" Threshold="25" RawValue="0" Status="Good"/>
                                    <local:SmartDataItem AttributeId="4" AttributeName="Start/Stop Count" Value="100" Worst="100" Threshold="20" RawValue="500" Status="Good"/>
                                    <local:SmartDataItem AttributeId="5" AttributeName="Reallocated Sectors Count" Value="50" Worst="45" Threshold="10" RawValue="50" Status="Warning"/>
                                    <local:SmartDataItem AttributeId="7" AttributeName="Seek Error Rate" Value="100" Worst="100" Threshold="50" RawValue="0" Status="Good"/>
                                    <local:SmartDataItem AttributeId="9" AttributeName="Power-On Hours" Value="90" Worst="90" Threshold="0" RawValue="5000" Status="Good"/>
                                    <local:SmartDataItem AttributeId="10" AttributeName="Spin Retry Count" Value="100" Worst="100" Threshold="97" RawValue="0" Status="Good"/>
                                    <local:SmartDataItem AttributeId="12" AttributeName="Power Cycle Count" Value="100" Worst="100" Threshold="20" RawValue="500" Status="Good"/>
                                    <local:SmartDataItem AttributeId="194" AttributeName="Temperature" Value="95" Worst="95" Threshold="0" RawValue="35" Status="Good"/>
                                    <local:SmartDataItem AttributeId="240" AttributeName="Head Flying Hours" Value="100" Worst="100" Threshold="0" RawValue="4500" Status="Good"/>
                                    <local:SmartDataItem AttributeId="241" AttributeName="Total Host Writes" Value="95" Worst="95" Threshold="0" RawValue="15000000" Status="Good"/>
                                    <local:SmartDataItem AttributeId="242" AttributeName="Total NAND Writes" Value="90" Worst="90" Threshold="0" RawValue="10000000" Status="Good"/>
                                </x:Array>
                            </DataGrid.ItemsSource>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Health History Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Health History" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- History Chart Placeholder -->
                    <Grid Grid.Row="1" Margin="16">
                        <Border Style="{StaticResource ChartCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Disk Health Over Time" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,12"/>
                                <Border Background="{DynamicResource MaterialDesignPaper}" 
                                        BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                        BorderThickness="1" CornerRadius="4" Height="250">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="ChartLine" Width="48" Height="48" 
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Health History Chart" FontSize="14" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                                        <TextBlock Text="(LiveCharts2 integration placeholder)" FontSize="10" 
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Time Range: " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="Last 30 Days" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Health Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" 
                                Content="Refresh" Margin="0,0,8,8" Click="Refresh_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24" 
                                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Refresh" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Run Full Test" Margin="0,0,8,8" Click="RunFullTest_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="MagnifyScan" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Full Test" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Quick Test" Margin="0,0,8,8" Click="RunQuickTest_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ClockFast" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Quick Test" FontSize="12" Foreground="{DynamicResource AccentHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Export Report" Margin="0,0,8,8" Click="ExportReport_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileExport" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Export" FontSize="12" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Settings" Margin="0,0,0,8" Click="Settings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="SystemHub.Views.DiskTools.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SystemHub.Views.DiskTools"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Disk Tools Overview" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- Header -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Harddisk" Width="32" Height="32" 
                                            Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Disk Tools Overview" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Disk Summary Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- Total Disks -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Server" Width="24" Height="24" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Total Disks" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="3" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Physical Disks" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="SSD" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="HDD" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Separator Orientation="Vertical" Style="{StaticResource CardDividerStyle}" Margin="8,0"/>
                            <StackPanel>
                                <TextBlock Text="Removable" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Total Storage -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Database" Width="24" Height="24" 
                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Total Storage" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="3.12 TB" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Combined Capacity" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="68" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource AccentHueMidBrush}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Used: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="2.12 TB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="Free: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="1.00 TB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Average Health -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HeartPulse" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,8,0"/>
                            <TextBlock Text="Average Health" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="88%" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,8,0,4"/>
                        <TextBlock Text="Good" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="88" Maximum="100" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource MaterialDesignSuccess}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Best: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="95%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignSuccess}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="Worst: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="75%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignWarning}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Temperature -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Thermometer" Width="24" Height="24" 
                                                    Foreground="{DynamicResource MaterialDesignError}" Margin="0,0,8,0"/>
                            <TextBlock Text="Temperature" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <TextBlock Text="38°C" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,8,0,4"/>
                        <TextBlock Text="Average" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                        <ProgressBar Value="38" Maximum="80" Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource MaterialDesignSuccess}" 
                                     Background="{DynamicResource MaterialDesignDividers}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Min: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="30°C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                            <TextBlock Text="Max: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="45°C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Physical Disks Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Harddisk" Width="20" Height="20" 
                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Physical Disks" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Disks List -->
                    <Grid Grid.Row="1" Margin="16">
                        <ListView Style="{StaticResource ListViewStyle}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                    <ContentPresenter Content="{TemplateBinding Content}" 
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Disk Icon -->
                                        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" 
                                                BorderBrush="{DynamicResource MaterialDesignDividers}" 
                                                BorderThickness="1" CornerRadius="8" Width="48" Height="48" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Harddisk" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource SecondaryHueMidBrush}" 
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Disk Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Model}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                                            <TextBlock Text="{Binding SerialNumber}" FontSize="11" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding InterfaceType}" FontSize="10" 
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text=" | " FontSize="10" 
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding MediaType}" FontSize="10" 
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Size -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                                            <TextBlock Text="Size" FontSize="10" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>
                                        
                                        <!-- Health -->
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                            <Border Background="{Binding HealthColor}" 
                                                    BorderBrush="{Binding HealthColor}" 
                                                    BorderThickness="1" CornerRadius="4" Padding="4,2">
                                                <TextBlock Text="{Binding HealthStatus}" FontSize="11" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Health" FontSize="10" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- Temperature -->
                                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Temperature}°C" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                                            <TextBlock Text="Temp" FontSize="10" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>
                                        
                                        <!-- Actions -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource CardActionButtonStyle}" 
                                                    Content="Details" Margin="0,0,4,0" Tag="{Binding DiskId}" 
                                                    Click="ViewDetails_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                                       Foreground="{TemplateBinding Foreground}" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                       Padding="4,2"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Style="{StaticResource CardActionButtonStyle}" 
                                                    Content="Benchmark" Margin="0,0,0,0" Tag="{Binding DiskId}" 
                                                    Click="RunBenchmark_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="4">
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                                       Foreground="{TemplateBinding Foreground}" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                       Padding="4,2"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            
                            <ListView.ItemsSource>
                                <x:Array Type="local:DiskItem">
                                    <local:DiskItem 
                                        DiskId="\\\\.\\PHYSICALDRIVE0" 
                                        Model="Samsung SSD 980 PRO 1TB" 
                                        SerialNumber="S5ABC123456789" 
                                        InterfaceType="NVMe" 
                                        MediaType="SSD" 
                                        Size="1000000000000" 
                                        HealthStatus="Good" 
                                        HealthColor="{DynamicResource MaterialDesignSuccess}" 
                                        Temperature="35" 
                                        SizeFormatted="1 TB"/>
                                    <local:DiskItem 
                                        DiskId="\\\\.\\PHYSICALDRIVE1" 
                                        Model="Seagate Barracuda 2TB" 
                                        SerialNumber="ZFL12345678" 
                                        InterfaceType="SATA" 
                                        MediaType="HDD" 
                                        Size="2000000000000" 
                                        HealthStatus="Warning" 
                                        HealthColor="{DynamicResource MaterialDesignWarning}" 
                                        Temperature="42" 
                                        SizeFormatted="2 TB"/>
                                    <local:DiskItem 
                                        DiskId="\\\\.\\PHYSICALDRIVE2" 
                                        Model="SanDisk Ultra 128GB" 
                                        SerialNumber="SD123456789" 
                                        InterfaceType="USB" 
                                        MediaType="SSD" 
                                        Size="128000000000" 
                                        HealthStatus="Good" 
                                        HealthColor="{DynamicResource MaterialDesignSuccess}" 
                                        Temperature="0" 
                                        SizeFormatted="128 GB"/>
                                </x:Array>
                            </ListView.ItemsSource>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Logical Drives Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Folder" Width="20" Height="20" 
                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Logical Drives" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Drives List -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Drive C -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource PrimaryHueMidBrush}" 
                                            BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
                                            BorderThickness="1" CornerRadius="50" Width="32" Height="32" Margin="0,0,8,0">
                                        <TextBlock Text="C" FontSize="16" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="OS (C:)" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="NTFS" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ProgressBar Value="45" Maximum="100" Height="6" CornerRadius="3"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="80"/>
                                    <TextBlock Text="45% Used" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Total: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="500 GB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Free: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="275 GB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignSuccess}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Explore" Tag="C" Click="ExploreDrive_Click"/>
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Cleanup" Tag="C" Click="CleanupDrive_Click" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Drive D -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource AccentHueMidBrush}" 
                                            BorderBrush="{DynamicResource AccentHueMidBrush}" 
                                            BorderThickness="1" CornerRadius="50" Width="32" Height="32" Margin="0,0,8,0">
                                        <TextBlock Text="D" FontSize="16" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Data (D:)" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="NTFS" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ProgressBar Value="65" Maximum="100" Height="6" CornerRadius="3"
                                                 Foreground="{DynamicResource AccentHueMidBrush}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="80"/>
                                    <TextBlock Text="65% Used" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Total: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="500 GB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Free: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="175 GB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignWarning}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Explore" Tag="D" Click="ExploreDrive_Click"/>
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Cleanup" Tag="D" Click="CleanupDrive_Click" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Drive E -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource SecondaryHueMidBrush}" 
                                            BorderBrush="{DynamicResource SecondaryHueMidBrush}" 
                                            BorderThickness="1" CornerRadius="50" Width="32" Height="32" Margin="0,0,8,0">
                                        <TextBlock Text="E" FontSize="16" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Storage (E:)" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="NTFS" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ProgressBar Value="75" Maximum="100" Height="6" CornerRadius="3"
                                                 Foreground="{DynamicResource SecondaryHueMidBrush}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="80"/>
                                    <TextBlock Text="75% Used" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Total: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="2 TB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Free: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="500 GB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignWarning}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Explore" Tag="E" Click="ExploreDrive_Click"/>
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Defrag" Tag="E" Click="DefragDrive_Click" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Drive F -->
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource MaterialDesignColor.DeepPurple500}" 
                                            BorderBrush="{DynamicResource MaterialDesignColor.DeepPurple500}" 
                                            BorderThickness="1" CornerRadius="50" Width="32" Height="32" Margin="0,0,8,0">
                                        <TextBlock Text="F" FontSize="16" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="USB Drive (F:)" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <TextBlock Text="exFAT" FontSize="11" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ProgressBar Value="30" Maximum="100" Height="6" CornerRadius="3"
                                                 Foreground="{DynamicResource MaterialDesignColor.DeepPurple500}" 
                                                 Background="{DynamicResource MaterialDesignDividers}" Width="80"/>
                                    <TextBlock Text="30% Used" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Total: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="128 GB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Free: " FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="90 GB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignSuccess}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Explore" Tag="F" Click="ExploreDrive_Click"/>
                                    <Button Style="{StaticResource CardActionButtonStyle}" 
                                            Content="Eject" Tag="F" Click="EjectDrive_Click" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Actions Section -->
            <Border Style="{StaticResource CardWithShadowStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" 
                                Content="Refresh" Margin="0,0,8,8" Click="Refresh_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24" 
                                                                    Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Refresh" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Disk Health" Margin="0,0,8,8" Click="DiskHealth_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="HeartPulse" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignSuccess}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Health" FontSize="12" Foreground="{DynamicResource MaterialDesignSuccess}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Benchmark" Margin="0,0,8,8" Click="Benchmark_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Speedometer" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Benchmark" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Cleanup" Margin="0,0,8,8" Click="Cleanup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Broom" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource AccentHueMidBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Cleanup" FontSize="12" Foreground="{DynamicResource AccentHueMidBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Settings" Margin="0,0,0,8" Click="Settings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" 
                                                                    Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
